<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ethiopian Horse Racing (ETHR) – Speed · Heritage · Future</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800;900&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #050504;
  --surface: #0e0d0a;
  --surface-card: linear-gradient(145deg, rgba(26,24,19,0.8), rgba(12,11,8,0.9));
  --text: #f3ead2;
  --muted: #a89f86;
  --gold: #d9b25a;
  --gold-bright: #fcd116;
  --gold2: #f2d48a;
  --gold-grad: linear-gradient(135deg, #f7e3a8 0%, #d9b25a 50%, #9e782f 100%);
  --gold-glow: rgba(217, 178, 90, 0.25);
  --line: rgba(217, 178, 90, 0.18);
  --line-bright: rgba(217, 178, 90, 0.4);
  --eth-green: #1e9a4b;
  --eth-yellow: #fcd116;
  --eth-red: #da121a;
  color-scheme: dark;
  box-sizing: border-box;
}

*, *::before, *::after {
  box-sizing: inherit;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  background-color: var(--bg);
  color: var(--text);
  font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, Arial, sans-serif;
  font-weight: 300;
  line-height: 1.7;
  letter-spacing: 0.02em;
  overflow-x: hidden;
}

h1, h2, h3, h4, .brand-title {
  font-family: 'Cinzel', Georgia, serif;
  font-weight: 700;
  letter-spacing: 0.05em;
}

a, button {
  -webkit-tap-highlight-color: transparent;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

/* --- FLAG ACCENT BAR --- */
.flag-bar {
  display: flex;
  height: 3px;
  width: 100%;
  position: relative;
  z-index: 10;
}
.flag-bar i {
  flex: 1;
}
.flag-bar i:nth-child(1) { background: var(--eth-green); }
.flag-bar i:nth-child(2) { background: var(--eth-yellow); }
.flag-bar i:nth-child(3) { background: var(--eth-red); }

/* --- HEADER & NAVIGATION --- */
header {
  position: sticky;
  top: 0;
  background: rgba(5, 5, 4, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
  z-index: 100;
}

nav {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 28px;
}

.brand-container {
  display: flex;
  align-items: center;
  gap: 14px;
  text-decoration: none;
}

.brand-logo {
  height: 46px;
  width: 46px;
  border-radius: 50%;
  border: 1px solid var(--gold);
  padding: 2px;
  background: var(--surface);
  box-shadow: 0 0 15px var(--gold-glow);
  object-fit: cover;
}

.brand-text {
  font-size: 15px;
  color: var(--gold2);
  text-transform: uppercase;
  letter-spacing: 0.15em;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 24px;
}

.nav-links a {
  color: var(--text);
  text-decoration: none;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  opacity: 0.8;
  position: relative;
  padding: 6px 0;
}

.nav-links a:hover {
  color: var(--gold2);
  opacity: 1;
}

.nav-links a::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 1px;
  background: var(--gold);
  transition: width 0.3s ease;
}

.nav-links a:hover::after {
  width: 100%;
}

.navbtn {
  border: 1px solid var(--gold) !important;
  padding: 9px 20px !important;
  color: var(--gold2) !important;
  opacity: 1 !important;
  background: rgba(217, 178, 90, 0.05);
}

.navbtn::after {
  display: none !important;
}

.navbtn:hover {
  background: var(--gold) !important;
  color: #000 !important;
  box-shadow: 0 0 20px var(--gold-glow);
}

/* --- HERO SECTION --- */
.hero {
  position: relative;
  text-align: center;
  padding: 100px 24px 120px;
  background: radial-gradient(circle at 50% 30%, rgba(217,178,90,0.12) 0%, rgba(5,5,4,0) 70%), var(--bg);
  overflow: hidden;
  border-bottom: 1px solid var(--line);
}

#dust {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 800px;
  margin: 0 auto;
}

.hero img {
  width: min(340px, 75vw);
  height: auto;
  display: block;
  margin: 0 auto 30px;
  filter: drop-shadow(0 10px 30px rgba(0,0,0,0.8)) drop-shadow(0 0 45px var(--gold-glow));
  animation: rise 1.4s cubic-bezier(0.16, 1, 0.3, 1) backwards, float 7s ease-in-out 1.4s infinite, glow 5s ease-in-out infinite;
}

.hero-subtitle {
  font-family: 'Cinzel', Georgia, serif;
  font-size: clamp(20px, 3.5vw, 32px);
  font-style: normal;
  font-weight: 500;
  color: var(--gold2);
  margin: 0 auto 16px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  animation: rise 1.4s 0.2s cubic-bezier(0.16, 1, 0.3, 1) backwards;
}

.hero p.desc {
  max-width: 580px;
  margin: 0 auto 40px;
  font-size: 16px;
  color: var(--muted);
  font-weight: 300;
  animation: rise 1.4s 0.4s cubic-bezier(0.16, 1, 0.3, 1) backwards;
}

.acta {
  display: flex;
  gap: 16px;
  justify-content: center;
  align-items: center;
  animation: rise 1.4s 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
}

/* --- BUTTONS --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--gold2);
  border: 1px solid var(--gold);
  padding: 16px 36px;
  border-radius: 0;
  letter-spacing: 0.2em;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.btn:hover {
  background: var(--gold);
  color: #000;
  box-shadow: 0 0 25px var(--gold-glow);
}

.btn.fill {
  background: var(--gold-grad);
  color: #000;
  border-color: transparent;
  font-weight: 700;
}

.btn.fill:hover {
  background: linear-gradient(135deg, #fff 0%, #f2d48a 100%);
  box-shadow: 0 0 30px rgba(242, 212, 138, 0.4);
}

/* --- MARQUEE --- */
.marquee {
  overflow: hidden;
  white-space: nowrap;
  background: #090806;
  border-block: 1px solid var(--line);
  padding: 20px 0;
  position: relative;
}

.marquee::before, .marquee::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  width: 80px;
  z-index: 2;
  pointer-events: none;
}
.marquee::before { left: 0; background: linear-gradient(to right, var(--bg), transparent); }
.marquee::after { right: 0; background: linear-gradient(to left, var(--bg), transparent); }

.marquee-content {
  display: inline-block;
  animation: slide 35s linear infinite;
  font-family: 'Cinzel', Georgia, serif;
  font-size: 20px;
  letter-spacing: 0.35em;
  color: var(--gold);
  text-transform: uppercase;
}

/* --- SECTIONS & HEADINGS --- */
section {
  max-width: 1200px;
  margin: 0 auto;
  padding: 110px 28px;
}

h2 {
  font-size: clamp(28px, 4.5vw, 42px);
  text-align: center;
  margin: 0 0 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: var(--gold-grad);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

h2::after {
  content: "";
  display: block;
  width: 50px;
  height: 2px;
  margin: 20px auto 0;
  background: var(--gold);
  box-shadow: 0 0 10px var(--gold);
}

.sub {
  color: var(--muted);
  text-align: center;
  margin: 0 0 60px;
  font-size: 15px;
  letter-spacing: 0.05em;
}

/* --- CARDS & GRID --- */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 28px;
}

.card {
  background: var(--surface-card);
  border: 1px solid var(--line);
  border-top: 2px solid var(--gold);
  padding: 40px 32px;
  position: relative;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
}

.card:hover {
  transform: translateY(-8px);
  border-color: var(--gold);
  box-shadow: 0 15px 35px rgba(0,0,0,0.5), 0 0 25px var(--gold-glow);
}

.card h3 {
  margin: 0 0 12px;
  font-size: 22px;
  color: var(--gold2);
  letter-spacing: 0.04em;
}

.card p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

.tag {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.25em;
  margin-bottom: 14px;
}

/* --- PILLARS --- */
.pillars-wrapper {
  background: #080705;
  border-block: 1px solid var(--line);
}

.pillars .card {
  background: transparent;
  border: 1px solid transparent;
  border-top: 1px solid var(--line);
  text-align: center;
  padding: 40px 24px;
}

.pillars .card:hover {
  border-top-color: var(--gold);
  background: rgba(217, 178, 90, 0.02);
  box-shadow: none;
}

/* --- CONTACT --- */
.contact {
  text-align: center;
}
.contact h2::after {
  margin-inline: auto;
}
.contact p {
  color: var(--muted);
  max-width: 500px;
  margin: 0 auto 36px;
}

/* --- FOOTER --- */
footer {
  text-align: center;
  color: var(--muted);
  font-size: 12px;
  letter-spacing: 0.1em;
  padding: 40px 24px;
  border-top: 1px solid var(--line);
  background: #030302;
}

/* --- REVEAL ANIMATION --- */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.reveal.in {
  opacity: 1;
  transform: none;
}

/* --- KEYFRAMES --- */
@keyframes rise {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}
@keyframes glow {
  0%, 100% { filter: drop-shadow(0 10px 30px rgba(0,0,0,0.8)) drop-shadow(0 0 35px rgba(217,178,90,0.2)); }
  50% { filter: drop-shadow(0 10px 30px rgba(0,0,0,0.8)) drop-shadow(0 0 65px rgba(217,178,90,0.45)); }
}
@keyframes slide {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* --- MODAL --- */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.88);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 20px;
  opacity: 1;
  transition: opacity 0.3s ease;
}
.modal[hidden] {
  display: none;
  opacity: 0;
}

.box {
  position: relative;
  width: 100%;
  max-width: 420px;
  background: #0d0c09;
  border: 1px solid var(--gold);
  box-shadow: 0 20px 50px rgba(0,0,0,0.9), 0 0 30px var(--gold-glow);
  padding: 40px 32px;
}

.x {
  position: absolute;
  top: 12px;
  right: 16px;
  background: none;
  border: 0;
  color: var(--muted);
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
  padding: 4px 8px;
}
.x:hover { color: var(--gold2); }

.tabs {
  display: flex;
  border-bottom: 1px solid var(--line);
  margin-bottom: 28px;
}

.tab {
  flex: 1;
  background: none;
  border: 0;
  border-bottom: 2px solid transparent;
  color: var(--muted);
  padding: 14px;
  font-family: 'Montserrat', sans-serif;
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  cursor: pointer;
}
.tab.on {
  color: var(--gold2);
  border-color: var(--gold);
}

.pane {
  display: grid;
  gap: 16px;
}
.pane[hidden] { display: none; }

.pane input {
  width: 100%;
  background: #040403;
  border: 1px solid var(--line);
  color: var(--text);
  padding: 14px 16px;
  font-family: 'Montserrat', sans-serif;
  font-size: 14px;
  border-radius: 0;
  transition: border-color 0.3s ease;
}
.pane input:focus {
  outline: 0;
  border-color: var(--gold);
  box-shadow: 0 0 10px var(--gold-glow);
}

.pane .btn {
  cursor: pointer;
  width: 100%;
  margin-top: 8px;
}

.sso {
  display: grid;
  gap: 12px;
  margin-bottom: 22px;
}

.sbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  padding: 14px;
  border: 1px solid #fff;
  font-family: 'Montserrat', sans-serif;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.05em;
  cursor: pointer;
  background: #fff;
  color: #111;
}
.sbtn:hover { background: #eee; }
.sbtn.ap {
  background: #000;
  color: #fff;
  border-color: #333;
}
.sbtn.ap:hover { background: #111; border-color: #555; }
.sbtn svg { width: 18px; height: 18px; }

.or {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 22px;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}
.or::before, .or::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--line);
}

.msg {
  min-height: 1.4em;
  margin: 16px 0 0;
  font-size: 13px;
  color: var(--gold2);
  text-align: center;
}

/* --- MEMBERS DASHBOARD --- */
#members {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: var(--bg);
  overflow-y: auto;
}
#members[hidden] { display: none; }

.mtop {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(5,5,4,0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
}

.mh {
  display: flex;
  align-items: center;
  gap: 16px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 14px 28px;
}
.mh img {
  height: 40px;
  width: 40px;
  border-radius: 50%;
  border: 1px solid var(--gold);
}
.mh span {
  flex: 1;
  font-family: 'Cinzel', Georgia, serif;
  font-size: 20px;
  color: var(--gold2);
  letter-spacing: 0.05em;
}

.mtabs {
  display: flex;
  max-width: 1200px;
  margin: 0 auto;
  border-bottom: 1px solid var(--line);
  overflow-x: auto;
}
.mtab {
  flex: 1;
  min-width: max-content;
  background: none;
  border: 0;
  border-bottom: 2px solid transparent;
  color: var(--muted);
  padding: 16px 20px;
  font-family: 'Montserrat', sans-serif;
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  cursor: pointer;
}
.mtab.on {
  color: var(--gold2);
  border-color: var(--gold);
}

.mbody {
  max-width: 1200px;
  margin: 0 auto;
  padding: 60px 28px 100px;
}
.mp[hidden] { display: none; }
.mbody .card .btn {
  margin-top: 20px;
  padding: 12px 24px;
  cursor: pointer;
}

.odds {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 14px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(217, 178, 90, 0.1);
}
.odds b {
  color: var(--gold2);
  font-weight: 600;
}

.note {
  font-size: 13px;
  color: var(--muted);
  margin-top: 30px;
  text-align: center;
  font-style: italic;
}

.mm {
  position: fixed;
  left: 50%;
  bottom: calc(30px + env(safe-area-inset-bottom, 0px));
  transform: translateX(-50%);
  background: var(--gold-grad);
  color: #000;
  padding: 14px 28px;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: 0.1em;
  z-index: 400;
  text-align: center;
  box-shadow: 0 10px 30px rgba(0,0,0,0.8), 0 0 20px var(--gold-glow);
}
.mm[hidden] { display: none; }

/* --- RESPONSIVE STYLES --- */
@media (hover: none) {
  .card:hover { transform: none; }
}

@media (max-width: 768px) {
  nav { padding: 12px 16px; }
  .brand-logo { height: 38px; width: 38px; }
  .brand-text { font-size: 13px; }
  .nav-links { gap: 12px; }
  .nav-links a { font-size: 10px; letter-spacing: 0.12em; }
  .nav-links a.navbtn { padding: 7px 12px !important; }
  
  .hero { padding: 60px 16px 80px; }
  .hero img { width: min(260px, 70vw); }
  .hero-subtitle { font-size: 20px; }
  .hero p.desc { font-size: 14px; margin-bottom: 30px; }
  
  section { padding: 70px 18px; }
  .pillars-wrapper section { padding-block: 50px !important; }
  h2 { font-size: 26px; }
  .card { padding: 28px 20px; }
  .card h3 { font-size: 20px; }
  .marquee { padding: 14px 0; }
  .marquee-content { font-size: 16px; letter-spacing: 0.2em; }
  
  .acta { flex-direction: column; gap: 12px; }
  .acta .btn { width: 100%; max-width: 280px; }
  
  .modal { align-items: flex-end; padding: 0; }
  .box {
    max-width: none;
    max-height: 90vh;
    overflow-y: auto;
    padding: 36px 20px calc(28px + env(safe-area-inset-bottom, 0px));
    border-width: 1px 0 0;
  }
  .tab, .sbtn { min-height: 48px; }
  .pane input { min-height: 48px; }
  .x { top: 8px; right: 12px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
  }
  .reveal { opacity: 1; transform: none; }
}
</style>
</head>
<body>

<div class="flag-bar"><i></i><i></i><i></i></div>

<header>
  <nav>
    <a href="#top" class="brand-container">
      <img src="data:image/jpeg;base64,
